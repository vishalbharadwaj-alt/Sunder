# SUNDER configuration
# Leave FALKORDB_MODE=embedded to run fully locally with no Docker.

FALKORDB_MODE=embedded
# For a remote/Docker FalkorDB instead, set:
# FALKORDB_MODE=remote
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=sunder

# Optional LLM planner. If unset, SUNDER uses its deterministic planner.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional: any OpenAI-compatible endpoint (Gemini, Groq, OpenRouter, local...)
# SUNDER_LLM_MODEL=gpt-4o-mini

# Demo target (crown jewel resource id)
CROWN_JEWEL=prod-secrets-vault
